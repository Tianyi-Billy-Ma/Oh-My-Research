{
  "mcpServers": {
    "exa": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/load-env-and-exec.sh",
      "args": ["npx", "-y", "exa-mcp-server"]
    },
    "tavily": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/load-env-and-exec.sh",
      "args": ["npx", "-y", "tavily-mcp"]
    },
    "brave-search": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/load-env-and-exec.sh",
      "args": ["npx", "-y", "@brave/brave-search-mcp-server"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer ${HF_TOKEN}"
      }
    }
  }
}
